# Copy this file to ~/.claude-accounts/openrouter.env and fill in your key.
# Get one at https://openrouter.ai/keys (format: sk-or-v1-...)
#
#   cp openrouter.env.example ~/.claude-accounts/openrouter.env
#   chmod 600 ~/.claude-accounts/openrouter.env
#   # then edit the file and paste your key
#
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
