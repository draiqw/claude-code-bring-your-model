# Copy this file to ~/.claude-accounts/openai.env and fill in your key.
# install.sh does this for you automatically (generating OPENAI_ADAPTER_TOKEN
# and leaving OPENAI_API_KEY for you to paste). To do it by hand:
#
#   cp openai.env.example ~/.claude-accounts/openai.env
#   chmod 600 ~/.claude-accounts/openai.env
#   # then edit the file: paste your key, replace the adapter token
#
# OPENAI_API_KEY is a plain OpenAI API key (platform.openai.com/api-keys),
# billed from your API project balance -- NOT your ChatGPT Plus/Pro
# subscription (that case is `claude-as codex`, see README).
OPENAI_API_KEY=sk-proj-replace-with-your-key

# OPENAI_ADAPTER_TOKEN is a local secret, not an OpenAI credential: it's how
# claude-as authenticates itself to the local adapter server on 127.0.0.1.
# Any random string works, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPENAI_ADAPTER_TOKEN=replace-with-a-random-local-secret
